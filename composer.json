{
  "name": "beksultan/blogs",
  "description": "Simple PHP blog project",
  "minimum-stability": "stable",
  "license": "proprietary",
  "authors": [
    {
      "name": "Beksultan Baimagambetov",
      "email": "bekabis55@gmail.com"
    }
